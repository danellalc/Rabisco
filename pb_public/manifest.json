{
  "name": "Trecos",
  "short_name": "Trecos",
  "description": "Every folder is a board. Keep files, write and organize everything in one light place.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#edebe7",
  "theme_color": "#edebe7",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "images", "accept": ["image/*"] }]
    }
  }
}
